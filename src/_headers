# ZDROJ: src/_headers — soubor _headers v kořeni generuje build.js (doplní hashe inline skriptů a stylů do CSP)

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' {{cspScriptHashes}} https://static.cloudflareinsights.com; style-src 'self' {{cspStyleHashes}}; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

/
  Link: </sitemap.xml>; rel="sitemap", </llms.txt>; rel="describedby"

/blog/*.html
  X-Robots-Tag: noindex, nofollow

/*/index.html
  X-Robots-Tag: noindex, nofollow

/index.html
  X-Robots-Tag: noindex, nofollow

/*.html
  X-Robots-Tag: noindex, nofollow

# Správa obsahu (Decap CMS) načítá skript z unpkg.com a přihlašuje se přes vyskakovací okno (window.opener) —
# přísná CSP ani izolace oken (COOP) by ji rozbily
/admin
  ! Content-Security-Policy
  ! Cross-Origin-Opener-Policy

/admin/*
  ! Content-Security-Policy
  ! Cross-Origin-Opener-Policy

# CSS a JS se odkazují s ?v=<otisk obsahu>, takže je lze cacheovat natrvalo
/main.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/favicon*
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  Cache-Control: public, max-age=3600

/web-app-manifest*
  Cache-Control: public, max-age=3600

/*.png
  Cache-Control: public, max-age=31536000, immutable
