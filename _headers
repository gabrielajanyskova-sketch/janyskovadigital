# ZDROJ: src/_headers — soubor _headers v kořeni generuje build.js (doplní hashe inline stylů do CSP)

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'sha256-+7REhQcwF0PhcjCMpfqhXwO0JHTVx9uvFmMbyjUGLvE='; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com https://cloudflareinsights.com; form-action 'self' https://api.web3forms.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

/
  Link: </sitemap.xml>; rel="sitemap", </llms.txt>; rel="describedby"

/blog/*.html
  X-Robots-Tag: noindex, nofollow

/*/index.html
  X-Robots-Tag: noindex, nofollow

/index.html
  X-Robots-Tag: noindex, nofollow

/*.html
  X-Robots-Tag: noindex, nofollow

# Správa obsahu (Decap CMS) načítá skripty z unpkg.com a identity.netlify.com — přísná CSP by ji rozbila
/admin
  ! Content-Security-Policy

/admin/*
  ! Content-Security-Policy

# CSS a JS se odkazují s ?v=<otisk obsahu>, takže je lze cacheovat natrvalo
/main.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/favicon*
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  Cache-Control: public, max-age=3600

/web-app-manifest*
  Cache-Control: public, max-age=3600

/*.png
  Cache-Control: public, max-age=31536000, immutable
